{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnspilotcompanion.local/schemas/performance-dataset-v1.json",
  "title": "Exact-aircraft POH/AFM performance dataset",
  "type": "object",
  "required": ["schemaVersion", "status", "aircraftIdentity", "source", "limitations", "configurations", "charts", "interpolation", "assumptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["draft", "validated", "approved"] },
    "aircraftIdentity": {
      "type": "object",
      "required": ["manufacturer", "model", "modelCode", "year", "serialApplicability", "engine", "propeller"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "modelCode": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "serialApplicability": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "propeller": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["documentTitle", "revision", "revisionDate", "checksumSha256", "transcribedBy", "transcribedAt", "independentlyVerifiedBy", "independentlyVerifiedAt", "approvedBy", "approvedAt"],
      "properties": {
        "documentTitle": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "revisionDate": { "type": "string", "format": "date" },
        "checksumSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "transcribedBy": { "type": "string", "minLength": 1 },
        "transcribedAt": { "type": "string", "format": "date-time" },
        "independentlyVerifiedBy": { "type": "string", "minLength": 1 },
        "independentlyVerifiedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "object", "required": ["weightLb", "pressureAltitudeFt", "temperatureC", "windKt"], "additionalProperties": true },
    "configurations": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "runwaySurface", "surfaceCondition", "flapSetting"], "additionalProperties": true } },
    "charts": {
      "type": "object",
      "required": ["takeoff", "landing", "climb"],
      "properties": {
        "takeoff": { "$ref": "#/$defs/chartList" },
        "landing": { "$ref": "#/$defs/chartList" },
        "climb": { "$ref": "#/$defs/chartList" }
      },
      "additionalProperties": false
    },
    "interpolation": { "type": "object", "required": ["method", "extrapolationAllowed"], "properties": { "method": { "const": "bounded-linear" }, "extrapolationAllowed": { "const": false } }, "additionalProperties": false },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "chartList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chart" } },
    "chart": {
      "type": "object",
      "required": ["id", "title", "page", "configurationId", "inputs", "outputs", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "minLength": 1 },
        "configurationId": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "points": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": { "type": "number" } } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
